<odoo>
    <!-- Individual view -->
    <record id="view_g2p_social_registry_individual_region" model="ir.ui.view">
        <field name="name">g2p.social.registry.individual.region</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="g2p_registry_individual.view_individuals_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='district']" position="before">
                <field name="region" />
            </xpath>
            <xpath expr="//field[@name='addl_name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tags_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='tags_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='phone_number_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='civil_status']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='occupation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='income']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='birth_place']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='birthdate_not_exact']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='groups']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='relationships']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Group view -->
    <record id="view_g2p_social_registry_group_region" model="ir.ui.view">
        <field name="name">g2p.social.registry.group.region</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="g2p_registry_group.view_groups_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='basic_info']/group/group" position="inside">
                    <field name="region" string="Region" />
            </xpath>
            <xpath expr="//field[@name='registration_date']" position="after">
                <field name="unique_id" readonly="1" invisible="1" />
            </xpath>
            <xpath expr="//page[@name='ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='relationships']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Group Filter Extensions For Search Criteria -->
    <record id="view_registry_groups_filter_social_registry" model="ir.ui.view">
        <field name="name">view.registry.groups.filter.social.registry</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="g2p_registry_group.view_registry_groups_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="unique_id" string="Unique ID" filter_domain="[('unique_id', 'ilike', self)]" />
            </xpath>
        </field>
    </record>

     <!-- Individual Filter Extensions For Search Criteria-->
    <record id="view_registry_individuals_filter_social_registry" model="ir.ui.view">
        <field name="name">view.registry.individuals.filter.social.registry</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="g2p_registry_individual.view_registry_individuals_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="unique_id" string="Unique ID" filter_domain="[('unique_id', 'ilike', self)]" />
            </xpath>
        </field>
    </record>


</odoo>
